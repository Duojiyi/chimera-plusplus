exports[`keeps the shell markup stable across views and the line editor > titlebar on another page 1`] = `
<header
  class="chimera-titlebar"
  data-pencil-name="标题栏"
>
  <div
    class="v3-crumb"
    data-tauri-drag-region="deep"
  >
    <span
      class="v3-crumb-tool"
    >
      Codex
    </span>
    <span
      aria-hidden="true"
      class="v3-crumb-sep"
    >
      /
    </span>
    <span
      class="v3-crumb-page"
    >
      Codex 管理
    </span>
    <span
      class="v5-version"
    >
      v
      2.9.4
    </span>
    <span
      class="v3-preview-chip"
      title="浏览器预览 · 未连接本机，不读取或修改本机配置"
    >
      浏览器预览 · 未连接本机
    </span>
  </div>
  <span
    aria-hidden="true"
    class="v5-window-name"
    data-tauri-drag-region="deep"
  >
    CHIMERA++
  </span>
  <button
    aria-label="搜索线路、页面或命令"
    class="v3-search"
    data-pencil-name="搜索"
    data-tauri-no-drag="true"
    type="button"
  >
    <svg
      aria-hidden="true"
      class="lucide lucide-search"
      fill="none"
      height="14"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="14"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="m21 21-4.34-4.34"
      />
      <circle
        cx="11"
        cy="11"
        r="8"
      />
    </svg>
    <span
      class="v3-search-placeholder"
    >
      搜索线路、页面或命令
    </span>
    <span
      aria-hidden="true"
      class="v3-kbd"
    >
      Ctrl K
    </span>
  </button>
  <div
    class="v3-window-controls"
    data-tauri-no-drag="true"
  >
    <div
      class="window-controls window-controls-windows"
      data-tauri-no-drag="true"
    >
      <button
        aria-label="最小化窗口"
        class="window-control-minimize"
        disabled=""
        title="仅桌面应用可用"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-minus"
          fill="none"
          height="14"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M5 12h14"
          />
        </svg>
      </button>
      <button
        aria-label="最大化窗口"
        class="window-control-maximize"
        disabled=""
        title="仅桌面应用可用"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-square"
          fill="none"
          height="12"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="12"
          xmlns="http://www.w3.org/2000/svg"
        >
          <rect
            height="18"
            rx="2"
            width="18"
            x="3"
            y="3"
          />
        </svg>
      </button>
      <button
        aria-label="关闭窗口"
        class="window-control-close"
        disabled=""
        title="仅桌面应用可用"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="lucide lucide-x"
          fill="none"
          height="14"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="14"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M18 6 6 18"
          />
          <path
            d="m6 6 12 12"
          />
        </svg>
      </button>
    </div>
  </div>
</header>
`;

