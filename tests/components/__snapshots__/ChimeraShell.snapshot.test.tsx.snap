    class="box-border flex-1 min-w-0 h-[40px] flex flex-row p-[0px_12px] justify-start items-center gap-2"
    data-pencil-name="左"
    data-tauri-drag-region="true"
  >
    <span
      class="text-[12px] text-[#646970] dark:text-[#8D9398] truncate"
      title="浏览器预览 · 未连接本机，不读取或修改本机配置"
