      aria-label="当前线路：未选择线路"
      class="mini-signboard"
      data-tauri-no-drag="true"
      title="点击返回线路页"
      type="button"
    >
      <span
        class="mini-signboard-stripe"
        style="background-color: var(--plate-fg-3);"
